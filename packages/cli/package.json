{
  "name": "@syncrea/exprit-cli",
  "version": "0.7.2",
  "description": "Command-line interface for exprit: evaluate expressions, pipe them through stdin, or explore them in a REPL.",
  "keywords": [
    "expression",
    "calculator",
    "cli",
    "repl",
    "exprit"
  ],
  "homepage": "https://exprit.syncrea.ch/getting-started/#command-line",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syncrea/exprit.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/syncrea/exprit/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "exprit": "./dist/main.mjs"
  },
  "exports": {
    ".": {
      "@syncrea/source": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "nx": {
    "name": "cli",
    "tags": [
      "scope:public",
      "layer:cli"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsdown",
          "cwd": "{projectRoot}"
        },
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "dependsOn": [
          "^build"
        ]
      }
    }
  },
  "dependencies": {
    "@syncrea/exprit": "workspace:*"
  }
}
