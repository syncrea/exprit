---
import Guide, { getHeadings } from '../guide/getting-started.mdx';
import DocsLayout from '../layouts/DocsLayout.astro';
import { REFERENCE_LINKS, type SidebarGroup, type TocItem } from '../lib/docs-nav';

const headings = getHeadings();
const sections = headings.filter((heading) => heading.depth === 2);

const sidebar: readonly SidebarGroup[] = [
  {
    title: 'Getting started',
    items: [
      { href: '/getting-started/', label: 'Quick start', current: true },
      ...sections.map((section) => ({ href: `#${section.slug}`, label: section.text, nested: true })),
    ],
  },
  {
    title: 'Reference',
    items: REFERENCE_LINKS.filter((link) => link.href !== '/getting-started/').map((link) => ({
      href: link.href,
      label: link.label,
    })),
  },
];

const toc: readonly TocItem[] = headings
  .filter((heading) => heading.depth <= 3)
  .map(({ depth, slug, text }) => ({ depth, slug, text }));
---

<DocsLayout
  title="Getting started"
  description="Install exprit, parse and evaluate your first expression, choose a dialect, add functions, and use the CLI."
  breadcrumb={['Getting started', 'Quick start']}
  sidebarLabel="Documentation"
  sidebar={sidebar}
  toc={toc}
  next={{ href: '/api/', label: 'API reference' }}
>
  <Guide />
</DocsLayout>

<style>
  :global(.prose > p:first-child) {
    font-size: 19px;
    line-height: 1.6;
  }

  :global(.next-cards) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 12px;
  }

  :global(.next-cards a) {
    padding: 18px 20px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    line-height: 1.5;
  }

  :global(.next-cards a:hover) {
    border-color: var(--line-strong);
  }

  :global(.next-cards strong) {
    font-size: 16px;
  }

  :global(.next-cards span) {
    font-size: 14px;
    color: var(--muted);
  }
</style>
