---
import { isCurrent, NAV, SITE } from '../lib/site';
import Spark from './Spark.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** `content` for the landing page width, `wide` for docs and the playground. */
  readonly width?: 'content' | 'wide';
  readonly showVersion?: boolean;
}

const { width = 'content', showVersion = false } = Astro.props;
const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class:list={['header-inner', `width-${width}`]}>
    <a class="brand" href="/">
      <Spark size={20} />
      <span class="brand-name">exprit</span>
      <span class="visually-hidden">home</span>
    </a>
    {
      showVersion && (
        <span class="version" title="Version of @syncrea/exprit these docs were built from">
          v{SITE.version}
        </span>
      )
    }
    <nav class="main-nav" aria-label="Main">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href, pathname) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="header-actions">
      <ThemeToggle />
      <details class="mobile-menu">
        <summary class="icon-btn" aria-label="Menu">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <nav aria-label="Main">
          <ul>
            {
              NAV.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href, pathname) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .header-inner {
    margin: 0 auto;
    min-height: var(--header-height);
    padding: 12px var(--gutter);
    display: flex;
    align-items: center;
    gap: 12px 28px;
  }

  .width-content {
    max-width: var(--content);
  }

  .width-wide {
    max-width: var(--wide);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: var(--text);
    text-decoration: none;
  }

  .brand-name {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 19px;
    letter-spacing: -0.04em;
  }

  .version {
    display: flex;
    align-items: center;
    height: 26px;
    padding: 0 8px;
    margin-left: -12px;
    border-radius: 6px;
    border: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  nav ul {
    display: flex;
    gap: 4px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--soft);
    font-size: 15px;
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }

  nav a[aria-current='page'] {
    font-weight: 500;
    box-shadow: inset 0 -2px 0 var(--accent-ink);
  }

  .header-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .mobile-menu {
    display: none;
    position: relative;
  }

  .mobile-menu summary {
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu[open] summary {
    border-color: var(--line-strong);
    background: var(--surface);
  }

  .mobile-menu nav {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    min-width: 220px;
    padding: 8px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.25);
  }

  .mobile-menu ul {
    flex-direction: column;
    gap: 2px;
  }

  .mobile-menu a {
    width: 100%;
    padding: 0 12px;
    border-radius: var(--radius-sm);
  }

  .mobile-menu a[aria-current='page'] {
    box-shadow: none;
    background: var(--tint);
    color: var(--accent-ink);
  }

  @media (max-width: 680px) {
    .main-nav {
      display: none;
    }

    .mobile-menu {
      display: block;
    }

    .header-inner {
      gap: 12px 16px;
    }
  }
</style>
