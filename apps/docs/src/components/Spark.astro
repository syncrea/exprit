---
/** The spark: the dot of the i in the wordmark, the favicon, and the "evaluated" marker. */
interface Props {
  readonly size?: number;
  readonly fill?: string;
  readonly class?: string;
  readonly animated?: boolean;
}

const {
  size = 20,
  fill = 'var(--accent-ink)',
  class: className,
  animated = false,
} = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
  class:list={[className, { 'spark-anim': animated }]}
>
  <path
    d="M12 1C12.8 7.5 16.5 11.2 23 12C16.5 12.8 12.8 16.5 12 23C11.2 16.5 7.5 12.8 1 12C7.5 11.2 11.2 7.5 12 1Z"
    fill={fill}></path>
</svg>
