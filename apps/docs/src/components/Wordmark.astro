---
/**
 * The exprit wordmark (mark 01, "Spark dot"): Geist Mono, with a dotless ı
 * whose dot is the spark. Screen readers get the plain name.
 */
interface Props {
  /** Font size in px. */
  readonly size?: number;
}

const { size = 64 } = Astro.props;
---

<span class="wordmark" style={`font-size: ${size}px`} role="img" aria-label="exprit">
  <span aria-hidden="true">expr</span><span class="wordmark-i" aria-hidden="true"
    >ı<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"
      ><path
        d="M12 1C12.8 7.5 16.5 11.2 23 12C16.5 12.8 12.8 16.5 12 23C11.2 16.5 7.5 12.8 1 12C7.5 11.2 11.2 7.5 12 1Z"
      ></path></svg
    ></span
  ><span aria-hidden="true">t</span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-mono);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--text);
  }

  .wordmark-i {
    position: relative;
    display: inline-block;
  }

  .wordmark-i svg {
    position: absolute;
    left: 50%;
    top: -0.14em;
    width: 0.4em;
    height: 0.4em;
    transform: translateX(-50%);
    fill: var(--accent-ink);
  }
</style>
